# Break-glass self-deploy secrets (`make self-deploy`). Copy this file to .env,
# which is gitignored, and fill it in. The deploy workflow receives these values
# as ${{ secrets.NAME }}. They are seeded per repo for the `gitmote` repo, by the
# GITMOTE_REPO_SECRET_<REPO>__<NAME> convention. <REPO> is the repo name in upper
# case, so gitmote becomes GITMOTE. gitmote never stores and never encrypts these
# values. The host env is the trust boundary (docs/architecture/ci.md).

# The Scaleway API credentials that deploy the container. The GitHub pipeline uses
# the same five. The access key starts with SCW. The secret key is a UUID.
GITMOTE_REPO_SECRET_GITMOTE__SCW_SECRET_KEY=
GITMOTE_REPO_SECRET_GITMOTE__SCW_ACCESS_KEY=
GITMOTE_REPO_SECRET_GITMOTE__SCW_ORGANIZATION_ID=
GITMOTE_REPO_SECRET_GITMOTE__SCW_PROJECT_ID=
GITMOTE_REPO_SECRET_GITMOTE__SCW_CONTAINER_ID=

# The GHCR push credentials: a PAT with write:packages. GitHub uses its built-in
# GITHUB_TOKEN. That token doesn't exist off GitHub, so the local path needs a PAT.
GITMOTE_REPO_SECRET_GITMOTE__GHCR_USER=
GITMOTE_REPO_SECRET_GITMOTE__GHCR_TOKEN=
